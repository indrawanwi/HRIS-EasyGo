{
  "name": "hris-easygo",
  "version": "0.1.0",
  "private": true,
  "description": "HRIS EasyGo enterprise system with Neon PostgreSQL & Next.js",
  "main": "src/server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "server": "node src/server.js",
    "dev:server": "nodemon src/server.js",
    "init-db": "node src/db/seed.js",
    "test": "node --test tests/*.test.js",
    "test:neon": "node --test tests/neon-smoke.test.js",
