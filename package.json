    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/sdk": "^6.0.0",
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^14.2.18",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "nodemon": "^3.1.14",
    "typescript": "^5.3.3"
  }
